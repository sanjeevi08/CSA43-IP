<!DOCTYPE html>
<html>
<head>
    <title>CSS Transition</title>

    <style>
        button {
            background-color: blue;
            color: white;
            padding: 15px 30px;
            font-size: 18px;
            border: none;
            border-radius: 8px;
            transition: background-color 0.5s, transform 0.5s;
        }

        button:hover {
            background-color: green;
            transform: scale(1.2);
        }
    </style>
</head>

<body>

    <h2>CSS Transition Example</h2>
    <button>Hover Me</button>
</body>
</html>
